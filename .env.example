# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Live transcription model (override if Google renames it)
GEMINI_MODEL=gemini-3.5-transcribe-live
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speech
# Set to "true" for hosted Postgres that needs SSL (Neon, Supabase, Render)
DATABASE_SSL=false
PORT=3000
